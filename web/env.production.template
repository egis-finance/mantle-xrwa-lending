# Production Environment Variables for Firebase Hosting
# Copy this file to .env.production and fill in your production values

# Mantle RPC (use production/mainnet RPC)
NEXT_PUBLIC_MANTLE_RPC=https://mantle.gateway.tenderly.co/YOUR_KEY

# Chain IDs
NEXT_PUBLIC_MANTLE_CHAIN_ID=5000
NEXT_PUBLIC_ETHEREUM_CHAIN_ID=1

# Contract Addresses (Production)
NEXT_PUBLIC_MANTLE_LOCKER=0x...
NEXT_PUBLIC_ETH_XCUSDY=0x...
NEXT_PUBLIC_ETH_RECEIVER=0x...
NEXT_PUBLIC_ETH_ORACLE=0x...
NEXT_PUBLIC_ETH_ADAPTER=0x...

# Token Addresses
NEXT_PUBLIC_MANTLE_USDY=0x5bE26527e817998A7206475496fDE1E68957c5A6
NEXT_PUBLIC_ETH_MORPHO=0xBBBBBbbBBb9cC5e90e3b3Af64bdAF62C37EEFFCb
NEXT_PUBLIC_ETH_USDC=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here
